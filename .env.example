# =====================================================================
# NEXAS HR — variabile de mediu necesare
# Copiaza acest fisier ca .env si completeaza valorile reale
# ATENTIE: .env nu se commit niciodata in git
# =====================================================================

# --- Baza de date ---
DATABASE_URL=sqlite:///./nexas_hr.db
# Productie (PostgreSQL):
# DATABASE_URL=postgresql://user:password@host:5432/nexas_hr

# --- Securitate sesiune ---
SECRET_KEY=schimba-aceasta-cheie-cu-una-random-de-min-32-caractere

# --- Autentificare platforma ---
HR_USERNAME=admin
HR_PASSWORD=parola-sigura-aici

# --- OpenRouter (AI pentru analiza CV si generare joburi) ---
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Gmail (trimitere notificari + citire inbox CV-uri) ---
GMAIL_EMAIL=adresa@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_FOLDER=INBOX
HR_NOTIFICATION_EMAIL=hr@companie.ro

# --- Google Drive (upload CV-uri) ---
GOOGLE_DRIVE_FOLDER_ID=1AbCdEfGhIjKlMnOpQrStUvWx
# Fisierele credentials.json si app/service_account.json trebuie
# sa existe local dar NU se commit in git

# --- Resend (email tranzactional) ---
RESEND_API_KEY=re_...
FROM_EMAIL=onboarding@resend.dev

# --- Cloudinary (stocare imagini) ---
CLOUDINARY_CLOUD_NAME=numele-cloud-ului
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz
